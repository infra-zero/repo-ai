{
	"name": "@infrazero/repo-ai",
	"version": "0.1.0",
	"description": "The ai-loop pipeline — loop mechanics, Claude Code skills, and their audit — split out of @rtorcato/repo-tooling",
	"type": "module",
	"bin": {
		"repo-ai": "./dist/cli/index.js"
	},
	"files": [
		"dist/**/*.js",
		"skills/*/SKILL.md",
		"workflows/*.js",
		"schemas/*.json",
		"README.md",
		"AGENTS.md",
		"statusline/*.sh"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"build": "rimraf ./dist && tsc --project tsconfig.build.json",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit --project tsconfig.build.json",
		"test": "vitest",
		"verify": "pnpm run check && pnpm run typecheck && pnpm test --run && pnpm run build",
		"prepare": "is-ci || husky"
	},
	"dependencies": {
		"chalk": "^6.0.1",
		"commander": "^15.0.0",
		"fs-extra": "^11.4.0",
		"inquirer": "^14.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@infrazero/repo-ai": "link:",
		"@rtorcato/repo-tooling": "^5.4.1",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.6.3",
		"conventional-changelog-conventionalcommits": "^10.4.0",
		"husky": "^9.1.7",
		"is-ci": "^4.1.0",
		"rimraf": "6.1.3",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/infra-zero/repo-ai.git"
	},
	"homepage": "https://docs.infrazero.dev/repo-ai/",
	"bugs": {
		"url": "https://github.com/infra-zero/repo-ai/issues"
	},
	"keywords": [
		"ai-agents",
		"claude-code",
		"cli",
		"developer-tools",
		"github-automation"
	],
	"license": "MIT",
	"author": "Richard Torcato"
}
