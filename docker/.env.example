# Copy to docker/.env and fill in. docker/.env and docker/*.pem are gitignored.

# The GitHub App the loop runs as (Settings → Developer settings → GitHub Apps).
# Its private key goes in docker/github-app.pem, not here.
GITHUB_APP_ID=

# Shared by the dashboard and the workers; the dashboard hands out tokens only
# to callers that know it. Generate one with:  openssl rand -hex 32
REPO_AI_WORKER_SECRET=

# Claude for the workers. Either a subscription token from `claude setup-token`…
CLAUDE_CODE_OAUTH_TOKEN=
# …or an API key (billed per token):
# ANTHROPIC_API_KEY=
