exports[`renderDash > renders a busy tick, without the body 1`] = `
"1pick 1rev  agents 2/6
status: line one
────────────────────────────────────────
pickups (1)
  #41
skipped pickups (1)
  #42  untrusted author
reviews to spawn (1)
